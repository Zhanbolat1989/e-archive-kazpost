# ---- Core ----
PROJECT_NAME=e-archive
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ---- PostgreSQL ----
POSTGRES_USER=earchive
POSTGRES_PASSWORD=earchive
POSTGRES_DB=earchive
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ---- MinIO (S3) ----
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
MINIO_ENDPOINT=minio:9000
MINIO_BUCKET=archive
MINIO_SECURE=false
# WORM retention for ingested originals, in days
MINIO_RETENTION_DAYS=3650

# ---- OpenSearch ----
OPENSEARCH_HOST=opensearch
OPENSEARCH_PORT=9200
OPENSEARCH_INDEX=documents

# ---- ClamAV ----
CLAMAV_HOST=clamav
CLAMAV_PORT=3310

# ---- Embeddings (fastembed / ONNX, no torch) ----
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DIM=384

# ---- OCR ----
# tesseract (по умолчанию, без GPU) | unlimited = baidu/Unlimited-OCR (VLM,
# сервис `ocr`, нужен GPU: OCR_ENGINE=unlimited + `--profile ocr up -d ocr`)
OCR_ENGINE=tesseract
OCR_SERVICE_URL=http://ocr:10000/v1
OCR_MODEL=Unlimited-OCR
OCR_FALLBACK_TESSERACT=true
# Доля VRAM под OCR-модель: остальное остаётся ollama (см. docker-compose)
OCR_GPU_FRACTION=0.45
OCR_LANGUAGES=rus+kaz+eng

# ---- LLM (Ollama, local RAG chat) ----
OLLAMA_HOST=ollama
OLLAMA_PORT=11434
# qwen2.5:7b — надёжный tool-calling, быстро на GPU. Для CPU: qwen2.5:3b.
OLLAMA_MODEL=qwen2.5:7b
RAG_TOP_K=4
RAG_CONTEXT_CHARS=2000
# Автономный агент с инструментами. Для слабых моделей (3b на CPU) — false.
AGENT_TOOL_LOOP=true

# ---- Информационная безопасность (ТС-176, раздел 14) ----
# Блокировка учётной записи после N неверных вводов пароля (п. 4.4)
LOGIN_MAX_ATTEMPTS=3
# Второй фактор: код на email при входе с нового устройства или второй сессии (п. 3)
TWOFA_ENABLED=true
TWOFA_CODE_TTL_MINUTES=10
TWOFA_MAX_ATTEMPTS=3
# Аудиторский след: срок оперативного и архивного доступа (п. 2 разд. 14)
AUDIT_OPERATIONAL_DAYS=90
AUDIT_ARCHIVE_DAYS=365

# ---- SMTP для кодов второго фактора ----
# Пока SMTP_HOST пуст, код второго фактора пишется в журнал сервера
# (docker compose logs backend) и наружу не отправляется. Для промышленной
# эксплуатации параметры ниже обязательны.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=e-archive <no-reply@earchive.kz>
SMTP_TLS=true

# ---- Bootstrap admin ----
FIRST_ADMIN_EMAIL=admin@earchive.kz
FIRST_ADMIN_PASSWORD=admin12345

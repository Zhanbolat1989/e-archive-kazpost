# ════════════════════════════════════════════════════════════════════════
#  ИС «Электронный архив» АО «Казпочта» (ТС-176) — шаблон конфигурации.
#  Промышленный контур:  cp .env.kazpost.example .env
#  Тестовая среда:       cp .env.kazpost.example .env.kazpost-test
#  Все значения с пометкой ЗАМЕНИТЬ обязательны: в режиме production сервис
#  не запустится с демонстрационными секретами.
# ════════════════════════════════════════════════════════════════════════

# ---- Редакция ----
PROJECT_NAME=ИС «Электронный архив» АО «Казпочта»
EDITION=kazpost
# Разделы, которые не показывать в этом развёртывании (через запятую).
# Для тестовой среды без сервера языковой модели: EDITION_DISABLED_MODULES=search
EDITION_DISABLED_MODULES=

# ---- Core ----
ENVIRONMENT=production
# ЗАМЕНИТЬ: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=480
# Фронтенд обращается к API через свой nginx, поэтому CORS не нужен.
CORS_ORIGINS=

# ---- PostgreSQL ----
POSTGRES_USER=earchive
# ЗАМЕНИТЬ
POSTGRES_PASSWORD=
POSTGRES_DB=earchive
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ---- MinIO (S3, WORM) ----
MINIO_ROOT_USER=earchive
# ЗАМЕНИТЬ
MINIO_ROOT_PASSWORD=
MINIO_ENDPOINT=minio:9000
MINIO_BUCKET=archive
MINIO_SECURE=false
MINIO_RETENTION_DAYS=3650

# ---- OpenSearch ----
OPENSEARCH_HOST=opensearch
OPENSEARCH_PORT=9200
OPENSEARCH_INDEX=documents

# ---- ClamAV (ИБ п. 2.10: антивирусная проверка загружаемых файлов) ----
CLAMAV_HOST=clamav
CLAMAV_PORT=3310

# ---- Эмбеддинги ----
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DIM=384

# ---- Распознавание (ТС 11.4) ----
OCR_ENGINE=tesseract
OCR_SERVICE_URL=http://ocr:10000/v1
OCR_MODEL=Unlimited-OCR
OCR_FALLBACK_TESSERACT=true
OCR_GPU_FRACTION=0.45
OCR_LANGUAGES=rus+kaz+eng

# ---- Языковая модель (локально, в контуре заказчика) ----
OLLAMA_HOST=ollama
OLLAMA_PORT=11434
OLLAMA_MODEL=qwen2.5:7b
AGENT_TOOL_LOOP=false

# ---- Информационная безопасность (ТС-176, раздел 14) ----
LOGIN_MAX_ATTEMPTS=3
TWOFA_ENABLED=true
TWOFA_CODE_TTL_MINUTES=10
TWOFA_MAX_ATTEMPTS=3
# Не менее 3 месяцев в оперативном и 1 года в архивном доступе (п. 6.2)
AUDIT_OPERATIONAL_DAYS=90
AUDIT_ARCHIVE_DAYS=365
# docker-compose.kazpost.yml ставит true: nginx перезаписывает X-Forwarded-For.
TRUST_PROXY_HEADERS=true
# п. 4.2: вход в мобильной версии по биометрии (ключи доступа WebAuthn).
# ЗАМЕНИТЬ: домен системы без схемы и порта (напр. archive.post.kz) и адрес
# страницы входа (напр. https://archive.post.kz). Для тестовой среды — свои.
WEBAUTHN_ENABLED=true
WEBAUTHN_RP_ID=
WEBAUTHN_RP_NAME=ИС «Электронный архив» АО «Казпочта»
WEBAUTHN_ORIGINS=

# ---- SMTP (коды второго фактора, уведомления) — ЗАМЕНИТЬ ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=ИС «Электронный архив» <no-reply@post.kz>
SMTP_TLS=true

# ---- Первый администратор — ЗАМЕНИТЬ ----
FIRST_ADMIN_EMAIL=
FIRST_ADMIN_PASSWORD=

# ---- Сертификат HTTPS (fullchain.pem + privkey.pem) ----
TLS_CERT_DIR=./certs

# ---- Резервное копирование (ТС-176 разд. 14 п. 1.1) ----
# Каталог копий — лучше отдельный диск. Для тестовой среды: ./backups-test
BACKUP_DIR=./backups
BACKUP_INTERVAL_HOURS=24
BACKUP_KEEP_DAYS=30

# ---- Проверка ЭЦП (ТС-176 разд. 14 п. 7, Правила № 1187) ----
# ncanode — ГОСТ 34.10-2015, цепочка до корня НУЦ РК, отзыв по OCSP (сервис
# ncanode в docker-compose.kazpost.yml). local — только для стенда без NCANode.
SIGNATURE_VERIFIER=ncanode
NCANODE_URL=http://ncanode:14579
SIGNATURE_REVOCATION_CHECK=OCSP

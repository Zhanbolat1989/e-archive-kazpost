.env
# Любые env-файлы развёртываний (тестовая среда и т.п.) содержат секреты;
# в репозитории остаются только шаблоны.
.env.*
!.env.example
!.env.kazpost.example
# Сертификат и закрытый ключ HTTPS
certs/
# Резервные копии базы и хранилища
backups*/
__pycache__/
*.pyc
node_modules/
dist/
.vite/
*.log
